# Copy to .env and fill in your own values. Do not commit .env.

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

DB_HOST=localhost
DB_PORT=5432
DB_NAME=geospatial_demo
DB_USER=agent_ro
DB_PASSWORD=your_password_here

# Optional write-capable credentials used only by scripts/load_ftw_summary.py
# Keep the runtime agent on the read-only DB_USER above.
ETL_DB_USER=your_database_owner_or_loader_role
ETL_DB_PASSWORD=your_loader_password
